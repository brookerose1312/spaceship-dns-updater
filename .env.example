# Required: Spaceship API credentials and DNS record selection
# Create a key in Spaceship's API Manager with dnsrecords:read and
# dnsrecords:write permissions.
SPACESHIP_HOST=@,*
SPACESHIP_DOMAIN=yourdomain.com
SPACESHIP_API_KEY=your_api_key
SPACESHIP_API_SECRET=your_api_secret

# Optional: DNS record TTL in seconds (60-3600; default: 300)
# SPACESHIP_TTL=300

# Optional: Timing
# CHECK_INTERVAL_MINUTES=5
# FORCE_UPDATE_DAYS=2

# Optional: Email notifications (disabled by default)
# When using Gmail, generate an App Password:
# https://myaccount.google.com/apppasswords
# EMAIL_ENABLED=true
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_gmail_app_password
# EMAIL_RECIPIENT=notify@example.com
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=587

# Optional: Timezone for log timestamps (default: UTC in Docker)
# TZ=Europe/Helsinki

# Optional: Log file (default: stdout only, set to enable file logging)
# LOG_FILE=spaceship_dns_updater.log
